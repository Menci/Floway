# Test material is excluded from the repository language statistics and hidden
# by default in GitHub diffs. It stays fully reviewable behind a click; only
# the default open state changes. The per-package `__tests__/` mirror is what
# makes this a single pattern instead of a scattered list.
# https://docs.github.com/en/repositories/working-with-files/managing-files/customizing-how-changed-files-appear-on-github
**/__tests__/**            linguist-generated=true
packages/test-utils/src/** linguist-generated=true

# Checked-in generator output. The `.generated.` infix is what keeps this a
# pattern rather than a list of paths; output named anything else opts itself
# out.
**/*.generated.*           linguist-generated=true
