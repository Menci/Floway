+            kind: 'assistant' as const,
+            assistantTurn: turn.items,
+            toIRInputTurns: () => openaiResponsesTurnToIR(turn),
+          }
+        : { kind: 'client' as const, toIRInputTurns: () => openaiResponsesTurnToIR(turn) }),
+    ],
+  };
+};
