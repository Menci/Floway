+import { TranslatorInputError } from '../../../types.ts';
+import type {
+  AnthropicMessagesClientTool,
+  AnthropicMessagesImageBlock,
+  AnthropicMessagesMetadataEx,
+  AnthropicMessagesMessage,
+  AnthropicMessagesPayload,
