new file mode 100644
index 000000000..a909f3f18
--- /dev/null
+++ b/packages/translate/src/shared/api-error.ts
@@ -0,0 +1,71 @@
+import { parseJSONObject } from './json/object.ts';
+import type { IRErrorPayload } from '../ir/common/error.ts';
+import type { TranslatedApiError } from '../types.ts';
+
+const recordOf = (value: unknown): Readonly<Record<string, unknown>> | undefined =>
+  typeof value === 'object' && value !== null && !Array.isArray(value) ? value as Readonly<Record<string, unknown>> : undefined;
+
+const stringOf = (value: unknown): string | undefined => typeof value === 'string' ? value : undefined;
+
+/**
+ * Reads a failed request's body as the error payload the IR carries.
+ *
+ * A protocol's error envelope nests a message and usually a machine-readable
+ * type or code, and every protocol we translate between puts them in one of a
+ * few places. Recognizing that shape is what lets a cross-protocol failure be
+ * restated in the client's own envelope.
+ *
+ * `undefined` means the body is not an error envelope this package recognizes.
+ * That is not a failure to parse: the answer is to leave the upstream's own
+ * status, headers, and bytes alone rather than inventing a shape for them.
+ */
+export const irErrorPayloadFromBody = (upstream: TranslatedApiError): IRErrorPayload | undefined => {
+  const text = new TextDecoder().decode(upstream.body);
+  let parsed: Readonly<Record<string, unknown>>;
+  try {
+    parsed = parseJSONObject(text);
+  } catch {
+    return undefined;
+  }
+
+  const nested = recordOf(parsed.error);
+  const error = nested ?? parsed;
+  const message = stringOf(error.message) ?? stringOf(error.msg);
+  if (message === undefined) return undefined;
+  const type = stringOf(error.type);
+  const code = stringOf(error.code) ?? stringOf(error.status);
+
+  return {
+    message,
+    ...(type === undefined ? {} : { type }),
+    ...(code === undefined ? {} : { code }),
+  };
+};
+
+/**
+ * Restates a failure in the client's envelope while keeping what it can.
+ *
+ * The upstream's status stands unless the recognized error means something the
+ * client's protocol spells with a different code, and every header the upstream
+ * sent is carried over — retry hints and request ids are as meaningful to the
+ * caller as the body is.
+ */
+export const restateError = (
+  upstream: TranslatedApiError,
+  body: Uint8Array,
+  status?: number,
+): TranslatedApiError => ({
+  status: status ?? upstream.status,
+  headers: restatedHeaders(upstream.headers),
+  body,
+});
+
+const restatedHeaders = (headers: Headers): Headers => {
+  const kept = new Headers(headers);
+  // The body is JSON whatever the upstream said, because it is one of ours now.
+  kept.set('content-type', 'application/json');
+  // A re-encoded body has a different length than the bytes it replaces.
+  kept.delete('content-length');
+  kept.delete('content-encoding');
+  return kept;
+};
diff --git a/packages/translate/src/shared/call-ids.ts b/packages/translate/src/shared/call-ids.ts
new file mode 100644
index 000000000..0ce4eed97
--- /dev/null
+++ b/packages/translate/src/shared/call-ids.ts
@@ -0,0 +1,76 @@
+import type { IRInputResolvedTurn } from '../ir/input/segments.ts';
+import type { IRInputAddressedAssistantItem, IRInputAddressedClientItem, IRInputAddressedTurn, IRInputTurn } from '../ir/input/types.ts';
+
+/** A call that has been stated and is still waiting for its result. */
+export interface PendingCall {
+  readonly name: string;
+  readonly callId: string;
+}
+
+/**
+ * States the call ids a target's wire requires.
+ *
+ * The input IR lets a source omit a call id: GenerateContent only states one
+ * when the caller had it, and a conversation restored from a sidecar never
+ * passed through the reading that would have seen it. Every translated target
+ * nevertheless correlates a result to its call by id, so the ids are filled in
+ * here — walking the conversation in order, which is what makes a result
+ * without an id answer the call still awaiting one.
+ *
+ * This is a target's own concern: the ids it invents are its wire's spelling of
+ * a call, and nothing outside this step reads them.
+ */
+export const assignCallIds = <Restored>(
+  pieces: readonly (IRInputTurn | IRInputResolvedTurn<Restored>)[],
+  restoredCalls: (turn: Restored) => readonly PendingCall[],
+): readonly (IRInputAddressedTurn | IRInputResolvedTurn<Restored>)[] => {
+  const pending: PendingCall[] = [];
+  let allocated = 0;
+  const allocate = (name: string): string => {
+    allocated += 1;
+    return `${name}_call_${allocated}`;
+  };
+  // A result without an id answers the oldest call of its name, or the oldest
+  // call at all when the source stated no name either.
+  const takePending = (name: string | undefined): PendingCall => {
+    const index = name === undefined ? 0 : pending.findIndex(call => call.name === name);
+    if (index < 0) throw new Error(`A tool result names '${name}', which no awaiting call states.`);
+    const [matched] = pending.splice(index, 1);
+    if (matched === undefined) throw new Error(`A tool result answers no call (name: ${name ?? 'unstated'}).`);
+    return matched;
+  };
+
+  return pieces.map((piece): IRInputAddressedTurn | IRInputResolvedTurn<Restored> => {
+    if (piece.kind === 'resolved') {
+      pending.push(...restoredCalls(piece.turn));
+      return piece;
+    }
+    if (piece.kind === 'client') {
+      const items: IRInputAddressedClientItem[] = [];
+      for (const item of piece.items) {
+        if (item.type !== 'tool_result') {
+          items.push(item);
+          continue;
+        }
+        // A stated answer releases its call so a later id-less result cannot
+        // take it.
+        const stated = item.call_id;
+        if (stated !== undefined) {
+          const index = pending.findIndex(call => call.callId === stated);
+          if (index >= 0) pending.splice(index, 1);
+          items.push({ ...item, call_id: stated });
+          continue;
+        }
+        items.push({ ...item, call_id: takePending(item.name).callId });
+      }
+      return { kind: 'client', items };
+    }
+    const items: IRInputAddressedAssistantItem[] = piece.items.map(item => {
+      if (item.type !== 'function_call' && item.type !== 'custom_tool_call') return item;
+      const callId = item.call_id ?? allocate(item.name);
+      pending.push({ name: item.name, callId });
+      return { ...item, call_id: callId };
+    });
+    return { kind: 'assistant', items };
+  });
+};
