+// Messages states the accelerated lane as `speed` and the general lane as
+// `service_tier`; every other protocol names both with the one tier string, so
+// `speed` wins when a request states both.
+// https://docs.claude.com/en/build-with-claude/fast-mode
+const serviceTierFromAnthropicMessages = (payload: AnthropicMessagesPayload): string | undefined => {
+  if (payload.speed === 'fast') return FAST_SERVICE_TIER;
+  // `standard` is the default lane, which a target already assumes.
+  if (payload.speed === 'standard') return undefined;
+  return payload.service_tier ?? undefined;
+};
+
+// A level stated outright wins over the one a thinking mode implies, because the
+// caller wrote it explicitly while the mode only bounds it.
+const reasoningEffortFromAnthropicMessages = (payload: AnthropicMessagesPayload): string | undefined => {
+  if (payload.output_config?.effort != null) return payload.output_config.effort;
+  if (payload.thinking?.type === 'disabled') return 'none';
+  if (payload.thinking?.type === 'enabled' || payload.thinking?.type === 'adaptive') return 'medium';
+  return undefined;
+};
+
+/**
+ * A Messages request prepared for translation.
+ *
+ * Messages states its prompt in a top-level field and its conversation in
+ * `messages`; both enter the IR, and the request-wide fields come from the same
+ * payload. Presenting them together keeps a route from assembling the request
+ * itself and then having to add the prompt separately.
+ *
+ * The conversation is returned unsegmented so a route can splice a
+ * sidecar-resolved assistant turn into it.
+ *
+ * Downgrading a server tool leaves a client turn of its own — the result the
+ * API wrote into the assistant message — and the caller's next message is
+ * usually a client turn too. Those two are one turn: everything from the
+ * server's answer up to the caller's next statement is the same speaking turn,
+ * and a writer that answers one turn with one message must see them together.
+ * So the trailing client turn is held back until the next source turn settles
+ * whether the two state the same turn. `flush` releases what is still held once
+ * the conversation ends, and a resolved turn releases it first because that turn
+ * is written natively and sits between the two.
+ */
+export const anthropicMessagesRead = (payload: AnthropicMessagesPayload): IRInputReading<AnthropicMessagesAssistantTurn> => {
+  const request: IRInputRequest = {
+    settings: anthropicMessagesSettingsToIR(payload),
+    ...anthropicMessagesToolsToIR(payload),
+  };
+
+  // Messages keeps a server tool's result inside the assistant message that
+  // called it, while the caller's next message is usually a client turn too.
+  // The result and that message are one speaking turn, so a client slot that
+  // ends the conversation is not emitted until the next source turn says
+  // whether it continues.
+  const turns: IRInputTurnSlot<AnthropicMessagesAssistantTurn>[] = [];
+  let messageIndex = 0;
+  let pendingClient: (() => IRInputTurn[]) | undefined;
+
+  const appendClient = (produce: () => IRInputTurn[]): void => {
+    if (pendingClient !== undefined) turns.push({ kind: 'client', toIRTurn: pendingClient });
+    pendingClient = produce;
+  };
+
+  const prompt = anthropicMessagesSystemToIR(payload.system);
+  if (prompt !== undefined) turns.push({ kind: 'client', toIRTurn: () => [prompt] });
+
+  for (const turn of partitionAnthropicMessagesTurns(payload.messages)) {
+    const firstMessageIndex = messageIndex;
+    messageIndex += turn.items.length;
+    if (turn.role === 'assistant') {
+      // An assistant turn always separates: whatever was held before it is a
+      // turn of its own, and its own output may interleave assistant and
+      // server-result client turns.
+      if (pendingClient !== undefined) {
+        turns.push({ kind: 'client', toIRTurn: pendingClient });
+        pendingClient = undefined;
+      }
+      turns.push({
+        kind: 'assistant',
+        assistantTurn: turn.items,
+        toIRTurn: () => anthropicMessagesTurnToIR(turn, firstMessageIndex),
+      });
+      continue;
+    }
+    appendClient(() => anthropicMessagesTurnToIR(turn, firstMessageIndex));
+  }
+  if (pendingClient !== undefined) turns.push({ kind: 'client', toIRTurn: pendingClient });
+
+  return { request, turns };
+};
