+import type { AnthropicMessagesAssistantTurn } from './round-trip.ts';
+import type { IRInputReading, IRInputTurnSlot } from '../../../ir/input/reading.ts';
+import type {
+  IRInputAssistantContentPart,
+  IRInputRequest,
+  IRInputSettings,
+  IRInputTool,
+  IRInputToolChoice,
+  IRInputOutputFormat,
+  IRInputAssistantItem,
+  IRInputMedia,
+  IRInputTextPart,
+  IRInputToolResultContentPart,
+  IRInputTurn,
+  IRInputUserContentPart,
+  IRInputClientItem,
