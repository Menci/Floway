#!/bin/sh
# Warn the agent after a commit / merge-commit / cherry-pick / FF lands
# from the main worktree (NOT from any linked worktree) while this clone works
# through linked worktrees. Always exits 0; the warning goes to stderr and
# never blocks the calling git command. `.husky/post-commit` and
# `.husky/post-merge` `exec` this script, so that exit 0 becomes the hook's
# own status.

"$(dirname "$0")/enforce-worktree" || exit 0

cat >&2 <<'WARNING'
WARNING! NOT in a worktree. Please double check: is the user really *explicitly* asking you to commit here?
The keywords "fix", "deploy", or "push" do NOT mean committing. If you were asked to do those, do those ONLY — they do NOT mean commit.
If this is genuinely an *explicit* user instruction telling you to commit, proceed.
If the user did not ask you to *commit*, reset to the previous state, apologize to the user, and continue with what *should* be done — without stopping.
WARNING

exit 0
